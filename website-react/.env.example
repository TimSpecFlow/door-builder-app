# SpecFlow landing site — build-time config
# Copy to `.env` and adjust per environment. Values are inlined at build time by Vite.

# URL of the Door Builder app (the "Door Builder" / "Start Your Project" CTAs).
# Local dev default is http://localhost:5174
VITE_DOOR_BUILDER_URL=https://builder.specflow.tech

# Endpoint the contact form posts to. In production the Cloudflare Worker is routed
# at specflow.tech/api/contact, so the relative default works when deployed there.
VITE_CONTACT_ENDPOINT=/api/contact
